// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
  "version": "2.0.0",
  "tasks": [
    {
        "label": "Run Extension",
        "type": "shell",
        "command": "code --extensionDevelopmentPath=${workspaceFolder}",
        "group": "test",
        "isBackground": true,
        "problemMatcher": []
    },
    {
        "type": "npm",
        "script": "watch",
        // esbuild watch (scripts/bundle.js --watch) never prints tsc's "Watching for file changes",
        // so $tsc-watch left the F5 preLaunchTask waiting forever. Match esbuild's own output instead.
        "problemMatcher": {
            "owner": "esbuild",
            "fileLocation": ["relative", "${workspaceFolder}"],
            "pattern": [
                { "regexp": "^✘ \\[ERROR\\] (.+)$", "message": 1 },
                { "regexp": "^\\s+(.+):(\\d+):(\\d+):\\s*$", "file": 1, "line": 2, "column": 3 }
            ],
            "background": {
                "activeBegins": true,
                "beginsPattern": "^\\s*watching for changes",
                "endsPattern": "^\\s*watching for changes"
            }
        },
        "isBackground": true,
        "presentation": {
            "reveal": "never"
        },
        "group": {
            "kind": "build",
            "isDefault": true
        }
    }
]
}